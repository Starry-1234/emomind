# M0: only the bare minimum. Real provider keys land in M1.
LANGGRAPH_INTERNAL_TOKEN=changeme-32-chars-min-internal-token
# Host-side defaults (dev runs ai-runtime outside compose via `uv run uvicorn`).
# Inside compose, these are overridden by compose.yml environment block
# (`db:5432`, `redis:6379` — Docker DNS resolves to the right container).
LANGGRAPH_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/emomind
LANGGRAPH_REDIS_URL=redis://localhost:6390
