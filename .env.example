# Domain
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5174

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="emomind心理测评平台"
STACK_NAME=emomind

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:5174,https://localhost,https://localhost:5173,https://localhost:5174"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (configure if you want to send emails)
SMTP_HOST=smtp.qq.com
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=your_email@qq.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=emomind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
 
SENTRY_DSN=

# Dify AI Configuration
DIFY_API_URL=http://your_ip/v1
DIFY_AI_DOCTOR_API_KEY=your_dify_ai_doctor_api_key
DIFY_TEST_API_KEY=your_dify_test_api_key

# Frontend (Vite requires VITE_ prefix for client-side env)
VITE_API_URL=http://localhost:8080

# Docker images (configure with your own registry images)
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
