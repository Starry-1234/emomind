import { createFileRoute, useNavigate } from "@tanstack/react-router"
import {
  Camera,
  CameraOff,
  Download,
  Pause,
  Play,
  RotateCcw,
  Upload,
  Video,
  VideoOff,
} from "lucide-react"
import { useCallback, useEffect, useRef, useState } from "react"

export const Route = createFileRoute("/_layout-backup/video-recording")({
  component: VideoRecording,
  head: () => ({
    meta: [{ title: "在线视频录制 - 心芯智联" }],
  }),
})

interface CameraDevice {
  deviceId: string
  label: string
}

export default function VideoRecording() {
  const navigate = useNavigate()
  const [cameraEnabled, setCameraEnabled] = useState(false)
  const [isRecording, setIsRecording] = useState(false)
  const [recordedBlob, setRecordedBlob] = useState<Blob | null>(null)
  const [videoUrl, setVideoUrl] = useState<string | null>(null)
  const [recordingTime, setRecordingTime] = useState(0)
  const [totalTime, setTotalTime] = useState(0)
  const [isPlaying, setIsPlaying] = useState(false)
  const [permissionDenied, setPermissionDenied] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [availableCameras, setAvailableCameras] = useState<CameraDevice[]>([])
  const [selectedCameraId, setSelectedCameraId] = useState<string>("")
  const [hasPermission, setHasPermission] = useState(false)
  const [isUploading, setIsUploading] = useState(false)

  const videoPreviewRef = useRef<HTMLVideoElement>(null)
  const mediaRecorderRef = useRef<MediaRecorder | null>(null)
  const videoChunksRef = useRef<Blob[]>([])
  const timerRef = useRef<number | null>(null)
  const videoRef = useRef<HTMLVideoElement>(null)
  const streamRef = useRef<MediaStream | null>(null)

  const getAvailableCameras = useCallback(async () => {
    try {
      const devices = await navigator.mediaDevices.enumerateDevices()
      const videoDevices = devices
        .filter((device) => device.kind === "videoinput")
        .map((device) => ({
          deviceId: device.deviceId,
          label: device.label || `摄像头 ${availableCameras.length + 1}`,
        }))
      setAvailableCameras(videoDevices)
      if (videoDevices.length > 0 && !selectedCameraId)
        setSelectedCameraId(videoDevices[0].deviceId)
    } catch (err) {
      console.error("获取摄像头列表失败:", err)
    }
  }, [availableCameras.length, selectedCameraId])

  useEffect(() => {
    getAvailableCameras()
    return () => {
      if (timerRef.current) clearInterval(timerRef.current)
      if (videoUrl) URL.revokeObjectURL(videoUrl)
      if (streamRef.current)
        streamRef.current.getTracks().forEach((track) => {
          track.stop()
        })
    }
  }, [getAvailableCameras, videoUrl])

  useEffect(() => {
    if (cameraEnabled && streamRef.current && videoPreviewRef.current) {
      videoPreviewRef.current.srcObject = streamRef.current
    }
  }, [cameraEnabled])

  const toggleCamera = async () => {
    if (cameraEnabled) {
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((track) => {
          track.stop()
        })
        streamRef.current = null
      }
      setCameraEnabled(false)
      if (videoPreviewRef.current) videoPreviewRef.current.srcObject = null
    } else {
      try {
        setPermissionDenied(false)
        setError(null)
        const constraints = selectedCameraId
          ? { video: { deviceId: selectedCameraId } }
          : { video: true }
        const stream = await navigator.mediaDevices.getUserMedia(constraints)
        streamRef.current = stream
        setHasPermission(true)
        if (videoPreviewRef.current) videoPreviewRef.current.srcObject = stream
        setCameraEnabled(true)
        await getAvailableCameras()
      } catch (err) {
        console.error("无法访问摄像头:", err)
        setPermissionDenied(true)
        setError("无法访问摄像头或麦克风，请检查权限设置")
      }
    }
  }

  const switchCamera = async () => {
    if (!streamRef.current) return
    try {
      streamRef.current.getTracks().forEach((track) => {
        track.stop()
      })
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { deviceId: selectedCameraId },
      })
      streamRef.current = stream
      if (videoPreviewRef.current) videoPreviewRef.current.srcObject = stream
    } catch (err) {
      console.error("切换摄像头失败:", err)
      setError("无法切换到选定的摄像头")
    }
  }

  const startRecording = async () => {
    if (!streamRef.current && !hasPermission) {
      setError("请先开启摄像头")
      return
    }
    try {
      setError(null)
      let stream = streamRef.current
      if (!stream) {
        const constraints = selectedCameraId
          ? { video: { deviceId: selectedCameraId }, audio: true }
          : { video: true, audio: true }
        stream = await navigator.mediaDevices.getUserMedia(constraints)
        streamRef.current = stream
        if (videoPreviewRef.current) videoPreviewRef.current.srcObject = stream
        setHasPermission(true)
        setCameraEnabled(true)
      }
      const mediaRecorder = new MediaRecorder(stream, {
        mimeType: "video/webm;codecs=vp9,opus",
      })
      mediaRecorderRef.current = mediaRecorder
      videoChunksRef.current = []
      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) videoChunksRef.current.push(event.data)
      }
      mediaRecorder.onstop = () => {
        const blob = new Blob(videoChunksRef.current, { type: "video/webm" })
        setRecordedBlob(blob)
        setVideoUrl(URL.createObjectURL(blob))
      }
      mediaRecorder.start()
      setIsRecording(true)
      setRecordingTime(0)
      timerRef.current = window.setInterval(() => {
        setRecordingTime((prev) => prev + 1)
        setTotalTime((prev) => prev + 1)
      }, 1000)
    } catch (err) {
      console.error("无法开始录制:", err)
      setError("无法开始录制，请重试")
    }
  }

  const stopRecording = () => {
    if (mediaRecorderRef.current && isRecording) {
      mediaRecorderRef.current.stop()
      setIsRecording(false)
      if (timerRef.current) {
        clearInterval(timerRef.current)
        timerRef.current = null
      }
    }
  }

  const downloadRecording = () => {
    if (!recordedBlob) return
    const timestamp = new Date().toISOString().slice(0, 19).replace(/[:-]/g, "")
    const a = document.createElement("a")
    a.href = URL.createObjectURL(recordedBlob)
    a.download = `视频_${timestamp}.webm`
    a.click()
  }

  const uploadToAnalysis = async () => {
    if (!recordedBlob) return
    setIsUploading(true)
    try {
      const timestamp = new Date()
        .toISOString()
        .slice(0, 19)
        .replace(/[:-]/g, "")
      const filename = `视频_${timestamp}.webm`
      const file = new File([recordedBlob], filename, { type: "video/webm" })
      const pendingFiles = JSON.parse(
        sessionStorage.getItem("pendingVideoFiles") || "[]",
      )
      pendingFiles.push({
        name: filename,
        type: "video",
        timestamp: Date.now(),
      })
      sessionStorage.setItem("pendingVideoFiles", JSON.stringify(pendingFiles))
      const reader = new FileReader()
      reader.onload = () => {
        const filesData = JSON.parse(
          sessionStorage.getItem("pendingFilesData") || "{}",
        )
        filesData[filename] = reader.result
        sessionStorage.setItem("pendingFilesData", JSON.stringify(filesData))
        setIsUploading(false)
        navigate({ to: "/file-upload" })
      }
      reader.readAsDataURL(file)
    } catch {
      console.error("上传失败:")
      setIsUploading(false)
      alert("上传失败，请重试")
    }
  }

  const playRecording = () => {
    if (!videoRef.current) return
    if (isPlaying) {
      videoRef.current.pause()
      setIsPlaying(false)
    } else {
      videoRef.current.play()
      setIsPlaying(true)
    }
  }

  const resetRecording = () => {
    if (videoUrl) URL.revokeObjectURL(videoUrl)
    setRecordedBlob(null)
    setVideoUrl(null)
    setRecordingTime(0)
    setTotalTime(0)
    setIsPlaying(false)
    videoChunksRef.current = []
  }

  const formatTime = (seconds: number) =>
    `${Math.floor(seconds / 60)
      .toString()
      .padStart(2, "0")}:${(seconds % 60).toString().padStart(2, "0")}`

  return (
    <div className="container mx-auto p-6 max-w-3xl">
      <h1 className="text-3xl font-bold mb-8 text-center">在线视频录制</h1>

      <div className="bg-white rounded-xl shadow-sm p-6 border">
        <div className="flex flex-col items-center gap-6">
          <div className="w-full aspect-video bg-gray-900 rounded-xl overflow-hidden relative">
            {!cameraEnabled && !videoUrl && (
              <div className="absolute inset-0 flex flex-col items-center justify-center text-gray-500">
                <VideoOff size={64} className="mb-4" />
                <p>点击下方按钮开启摄像头</p>
              </div>
            )}
            {cameraEnabled && !recordedBlob && (
              <video
                ref={videoPreviewRef}
                autoPlay
                muted
                playsInline
                className="w-full h-full object-cover transform -scale-x-100"
              />
            )}
            {recordedBlob && videoUrl && (
              <video
                ref={videoRef}
                src={videoUrl}
                controls
                className="w-full h-full object-contain"
                onEnded={() => setIsPlaying(false)}
              >
                <track kind="captions" />
              </video>
            )}
            {isRecording && (
              <div className="absolute top-4 left-4 flex items-center gap-2 px-3 py-1.5 bg-red-500 text-white rounded-full text-sm font-medium">
                <span className="w-2 h-2 bg-white rounded-full animate-pulse" />
                录制中
              </div>
            )}
            {cameraEnabled && !recordedBlob && (
              <div className="absolute top-4 right-4">
                <span className="px-3 py-1.5 bg-green-500 text-white rounded-full text-sm font-medium">
                  摄像头已开启
                </span>
              </div>
            )}
          </div>

          <div className="text-center">
            {isRecording ? (
              <>
                <p className="text-3xl font-mono text-red-500">
                  {formatTime(recordingTime)}
                </p>
                <p className="text-gray-500">正在录制...</p>
                {totalTime > 0 && (
                  <p className="text-sm text-gray-400">
                    总时长: {formatTime(totalTime)}
                  </p>
                )}
              </>
            ) : recordedBlob ? (
              <>
                <p className="text-3xl font-mono text-gray-700">
                  {formatTime(totalTime)}
                </p>
                <p className="text-green-500">录制完成</p>
              </>
            ) : cameraEnabled ? (
              <>
                <p className="text-3xl font-mono text-gray-400">00:00</p>
                <p className="text-gray-500">准备录制</p>
              </>
            ) : (
              <>
                <p className="text-3xl font-mono text-gray-400">00:00</p>
                <p className="text-gray-500">等待开启摄像头</p>
              </>
            )}
          </div>

          {permissionDenied && (
            <div className="w-full p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 text-center">
              摄像头或麦克风权限被拒绝，请允许浏览器访问后重试。
            </div>
          )}
          {error && (
            <div className="w-full p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 text-center">
              {error}
            </div>
          )}

          {availableCameras.length > 0 && cameraEnabled && (
            <div className="w-full max-w-md mb-4 p-3 bg-gray-50 rounded-lg">
              <label
                htmlFor="camera-select"
                className="block text-sm font-medium text-gray-700 mb-2"
              >
                选择摄像头：
              </label>
              <select
                id="camera-select"
                value={selectedCameraId}
                onChange={(e) => {
                  setSelectedCameraId(e.target.value)
                  switchCamera()
                }}
                className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                {availableCameras.map((camera, index) => (
                  <option key={camera.deviceId} value={camera.deviceId}>
                    {camera.label || `摄像头 ${index + 1}`}
                  </option>
                ))}
              </select>
            </div>
          )}

          <div className="flex gap-4 flex-wrap justify-center">
            {!recordedBlob ? (
              <>
                <button
                  type="button"
                  onClick={toggleCamera}
                  disabled={isRecording}
                  className={`px-6 py-3 rounded-xl font-semibold transition-all flex items-center gap-2 ${cameraEnabled ? `bg-red-500 hover:bg-red-600 text-white` : `bg-purple-500 hover:bg-purple-600 text-white`} ${isRecording ? `opacity-50 cursor-not-allowed` : ``}`}
                >
                  {cameraEnabled ? (
                    <>
                      <CameraOff size={20} />
                      关闭摄像头
                    </>
                  ) : (
                    <>
                      <Camera size={20} />
                      开启摄像头
                    </>
                  )}
                </button>
                {cameraEnabled && (
                  <button
                    type="button"
                    onClick={isRecording ? stopRecording : startRecording}
                    className={`px-8 py-3 rounded-xl font-semibold text-white transition-all flex items-center gap-2 ${isRecording ? `bg-red-500 hover:bg-red-600` : `bg-green-500 hover:bg-green-600`}`}
                  >
                    {isRecording ? (
                      <>
                        <span className="w-5 h-5 flex items-center justify-center">
                          <span className="w-3 h-3 bg-white rounded-sm" />
                        </span>
                        停止录制
                      </>
                    ) : (
                      <>
                        <Video size={20} />
                        开始录制
                      </>
                    )}
                  </button>
                )}
              </>
            ) : (
              <>
                <button
                  type="button"
                  onClick={playRecording}
                  className="px-6 py-3 bg-blue-500 text-white rounded-xl font-semibold hover:bg-blue-600 transition-all flex items-center gap-2"
                >
                  {isPlaying ? (
                    <>
                      <Pause size={20} />
                      暂停
                    </>
                  ) : (
                    <>
                      <Play size={20} />
                      播放
                    </>
                  )}
                </button>
                <button
                  type="button"
                  onClick={uploadToAnalysis}
                  disabled={isUploading}
                  className="px-6 py-3 bg-green-500 text-white rounded-xl font-semibold hover:bg-green-600 transition-all flex items-center gap-2 disabled:opacity-50"
                >
                  <Upload size={20} />
                  {isUploading ? "上传中..." : "直接上传"}
                </button>
                <button
                  type="button"
                  onClick={downloadRecording}
                  className="px-6 py-3 bg-green-500 text-white rounded-xl font-semibold hover:bg-green-600 transition-all flex items-center gap-2"
                >
                  <Download size={20} />
                  下载视频
                </button>
                <button
                  type="button"
                  onClick={resetRecording}
                  className="px-6 py-3 bg-gray-200 text-gray-700 rounded-xl font-semibold hover:bg-gray-300 transition-all flex items-center gap-2"
                >
                  <RotateCcw size={20} />
                  重新录制
                </button>
              </>
            )}
          </div>
        </div>
      </div>

      <div className="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-200">
        <h3 className="font-semibold text-blue-800 mb-2">使用说明</h3>
        <ul className="text-sm text-blue-700 space-y-1">
          <li>1. 点击「开启摄像头」按钮，允许浏览器访问摄像头和麦克风</li>
          <li>2. 如有多个摄像头，可通过下拉框切换选择</li>
          <li>3. 在预览中确认画面和声音正常</li>
          <li>4. 点击「开始录制」按钮开始录制视频</li>
          <li>5. 录制过程中会同时录制音频</li>
          <li>6. 点击「直接上传」可跳转至分析页面</li>
          <li>7. 视频格式为 WebM，兼容大多数浏览器</li>
        </ul>
      </div>
    </div>
  )
}
