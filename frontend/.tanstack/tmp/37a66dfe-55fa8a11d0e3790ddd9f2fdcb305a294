import { createFileRoute } from "@tanstack/react-router"
import {
  ChevronDown,
  ChevronUp,
  Mic,
  ThumbsDown,
  ThumbsUp,
  Volume2,
  VolumeX,
} from "lucide-react"
import { useCallback, useEffect, useRef, useState } from "react"
import useAuth from "@/hooks/useAuth"
import { difyService, type RetrieverResource } from "@/lib/difyService"

export const Route = createFileRoute("/_layout-backup/counselor-chat")({
  component: CounselorChat,
  head: () => ({
    meta: [
      {
        title: "智能心理咨询师 - 心芯智联",
      },
    ],
  }),
})

interface ChatMessage {
  id: string
  role: "user" | "assistant"
  content: string
  created_at?: number
  message_id?: string
  retriever_resources?: RetrieverResource[]
  feedback?: "like" | "dislike" | null
  suggested_questions?: string[]
}

export default function CounselorChat() {
  const { user } = useAuth()
  const [messages, setMessages] = useState<ChatMessage[]>([])
  const [inputValue, setInputValue] = useState("")
  const [isLoading, setIsLoading] = useState(false)
  const [conversationId, setConversationId] = useState<string | null>(null)
  const [openingStatement, setOpeningStatement] = useState<string>("")
  const [suggestedQuestions, setSuggestedQuestions] = useState<string[]>([])
  const [isRecording, setIsRecording] = useState(false)
  const [transcribeStatus, setTranscribeStatus] = useState<
    "idle" | "listening" | "transcribing" | "done"
  >("idle")
  const [speechToTextEnabled, setSpeechToTextEnabled] = useState(false)
  const [textToSpeechEnabled, setTextToSpeechEnabled] = useState(false)
  const [autoPlayTTS, setAutoPlayTTS] = useState(false)
  const [playingAudioId, setPlayingAudioId] = useState<string | null>(null)
  const [expandedCitations, setExpandedCitations] = useState<Set<string>>(
    new Set(),
  )
  const messagesEndRef = useRef<HTMLDivElement>(null)
  const inputRef = useRef<HTMLTextAreaElement>(null)
  const mediaRecorderRef = useRef<MediaRecorder | null>(null)
  const audioChunksRef = useRef<Blob[]>([])
  const audioRef = useRef<HTMLAudioElement | null>(null)

  const loadAppConfig = useCallback(async () => {
    try {
      const params = await difyService.getParameters()
      setOpeningStatement(
        params.opening_statement ||
          "你好，我是AI心理咨询师，很高兴为你服务。有什么心事想和我聊聊吗？",
      )
      setSuggestedQuestions(
        params.suggested_questions || [
          "最近感觉压力大怎么办？",
          "如何改善睡眠质量？",
          "和家人沟通有困难怎么办？",
        ],
      )
      setSpeechToTextEnabled(params.speech_to_text?.enabled || false)
      setTextToSpeechEnabled(params.text_to_speech?.enabled || false)
    } catch (error) {
      console.error("获取应用配置失败:", error)
      setOpeningStatement(
        "你好，我是AI心理咨询师，很高兴为你服务。有什么心事想和我聊聊吗？",
      )
      setSuggestedQuestions([
        "最近感觉压力大怎么办？",
        "如何改善睡眠质量？",
        "和家人沟通有困难怎么办？",
      ])
    }
  }, [])

  const loadHistory = useCallback(async () => {
    if (!user?.id) return
    try {
      const conversations = await difyService.getConversations(user.id)
      if (conversations.data.length > 0) {
        const latestConv = conversations.data[0]
        setConversationId(latestConv.id)
        const msgs = await difyService.getMessages(user.id, latestConv.id)
        const formattedMessages: ChatMessage[] = []
        for (const msg of msgs.data) {
          formattedMessages.push({
            id: msg.id,
            role: "user" as const,
            content: msg.query,
            created_at: msg.created_at,
          })
          formattedMessages.push({
            id: `${msg.id}-assistant`,
            role: "assistant",
            content: msg.answer,
            created_at: msg.created_at,
          })
        }
        formattedMessages.sort(
          (a, b) => (a.created_at || 0) - (b.created_at || 0),
        )
        setMessages(formattedMessages)
      }
    } catch (error) {
      console.error("加载历史记录失败:", error)
    }
  }, [user?.id])

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" })
  }, [])

  useEffect(() => {
    loadAppConfig()
  }, [loadAppConfig])

  useEffect(() => {
    if (user?.id) {
      loadHistory()
    }
  }, [user?.id, loadHistory])

  const startRecording = async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
      const mediaRecorder = new MediaRecorder(stream)
      mediaRecorderRef.current = mediaRecorder
      audioChunksRef.current = []

      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) {
          audioChunksRef.current.push(event.data)
        }
      }

      mediaRecorder.onstop = async () => {
        const audioBlob = new Blob(audioChunksRef.current, {
          type: "audio/webm",
        })
        for (const track of stream.getTracks()) {
          track.stop()
        }
        setIsRecording(false)
        setTranscribeStatus("transcribing")
        try {
          if (user?.id) {
            const text = await difyService.audioToText(audioBlob, user.id)
            setInputValue((prev) => prev + text)
            setTranscribeStatus("done")
            setTimeout(() => setTranscribeStatus("idle"), 1500)
          }
        } catch (error) {
          console.error("语音转文字失败:", error)
          setTranscribeStatus("idle")
        }
      }

      mediaRecorder.start()
      setIsRecording(true)
      setTranscribeStatus("listening")
    } catch (error) {
      console.error("无法访问麦克风:", error)
    }
  }

  const stopRecording = () => {
    if (mediaRecorderRef.current && isRecording) {
      mediaRecorderRef.current.stop()
    }
  }

  const handleFeedback = async (
    messageId: string,
    rating: "like" | "dislike",
  ) => {
    if (!user?.id) return
    try {
      const currentMessage = messages.find((m) => m.message_id === messageId)
      const newRating = currentMessage?.feedback === rating ? null : rating

      await difyService.feedbackMessage(messageId, user.id, newRating || null)

      setMessages((prev) =>
        prev.map((msg) =>
          msg.message_id === messageId ? { ...msg, feedback: newRating } : msg,
        ),
      )
    } catch (error) {
      console.error("反馈失败:", error)
    }
  }

  const loadSuggestedQuestions = async (messageId: string) => {
    if (!user?.id) return
    try {
      const questions = await difyService.getSuggestedQuestions(
        messageId,
        user.id,
      )
      setMessages((prev) =>
        prev.map((msg) =>
          msg.message_id === messageId
            ? { ...msg, suggested_questions: questions }
            : msg,
        ),
      )
    } catch (error) {
      console.error("获取建议问题失败:", error)
    }
  }

  const handleSend = async () => {
    if (!inputValue.trim() || !user?.id || isLoading) return

    const userMessage: ChatMessage = {
      id: Date.now().toString(),
      role: "user",
      content: inputValue.trim(),
    }

    setMessages((prev) => [...prev, userMessage])
    setInputValue("")
    setIsLoading(true)

    const assistantMessageId = (Date.now() + 1).toString()
    setMessages((prev) => [
      ...prev,
      { id: assistantMessageId, role: "assistant", content: "" },
    ])

    let fullAnswer = ""

    try {
      const result = await difyService.sendMessage(
        user.id,
        userMessage.content,
        conversationId || undefined,
        (chunk) => {
          fullAnswer += chunk
          setMessages((prev) =>
            prev.map((msg) =>
              msg.id === assistantMessageId
                ? { ...msg, content: fullAnswer }
                : msg,
            ),
          )
        },
      )

      if (result.conversation_id && !conversationId) {
        setConversationId(result.conversation_id)
      }

      setMessages((prev) =>
        prev.map((msg) =>
          msg.id === assistantMessageId
            ? {
                ...msg,
                message_id: result.message_id,
                retriever_resources: result.retriever_resources,
              }
            : msg,
        ),
      )

      loadSuggestedQuestions(result.message_id)

      if (autoPlayTTS && textToSpeechEnabled && fullAnswer) {
        playTTS(result.message_id, fullAnswer)
      }
    } catch (error) {
      console.error("发送消息失败:", error)
      setMessages((prev) =>
        prev.map((msg) =>
          msg.id === assistantMessageId
            ? { ...msg, content: "抱歉，发送消息失败了，请稍后重试。" }
            : msg,
        ),
      )
    } finally {
      setIsLoading(false)
      inputRef.current?.focus()
    }
  }

  const playTTS = async (messageId: string, text: string) => {
    if (!user?.id) return
    if (playingAudioId === messageId) {
      audioRef.current?.pause()
      setPlayingAudioId(null)
      return
    }

    try {
      const audioBlob = await difyService.textToAudio(text, user.id, messageId)
      const audioUrl = URL.createObjectURL(audioBlob)
      if (audioRef.current) {
        audioRef.current.pause()
      }
      audioRef.current = new Audio(audioUrl)
      audioRef.current.onended = () => setPlayingAudioId(null)
      audioRef.current.onerror = () => setPlayingAudioId(null)
      audioRef.current.play()
      setPlayingAudioId(messageId)
    } catch (error) {
      console.error("播放语音失败:", error)
    }
  }

  const toggleCitation = (messageId: string) => {
    setExpandedCitations((prev) => {
      const next = new Set(prev)
      if (next.has(messageId)) {
        next.delete(messageId)
      } else {
        next.add(messageId)
      }
      return next
    })
  }

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault()
      handleSend()
    }
  }

  const handleNewChat = () => {
    setMessages([])
    setConversationId(null)
    loadAppConfig()
  }

  if (!user) {
    return (
      <div className="flex items-center justify-center h-64">
        <p className="text-muted-foreground">请先登录后再使用心理咨询服务</p>
      </div>
    )
  }

  return (
    <div className="counselor-chat-container">
      <audio ref={audioRef}>
        <track kind="captions" />
      </audio>

      <div className="counselor-chat-header">
        <div className="flex items-center justify-between">
          <div>
            <h2 className="text-3xl font-semibold text-gray-800">
              智能心理咨询师
            </h2>
            <p className="text-gray-500 text-lg">
              与我们的AI心理咨询师进行对话，获取专业的心理支持
            </p>
          </div>
          <div className="header-actions">
            {textToSpeechEnabled && (
              <button
                type="button"
                className={`auto-play-btn ${autoPlayTTS ? `active` : ``}`}
                onClick={() => setAutoPlayTTS(!autoPlayTTS)}
                title={autoPlayTTS ? "关闭自动播放语音" : "开启自动播放语音"}
              >
                {autoPlayTTS ? <Volume2 size={18} /> : <VolumeX size={18} />}
                <span>{autoPlayTTS ? "自动播放" : "手动播放"}</span>
              </button>
            )}
            {messages.length > 0 && (
              <button
                type="button"
                onClick={handleNewChat}
                className="new-chat-btn"
              >
                新对话
              </button>
            )}
          </div>
        </div>
      </div>

      <div className="chat-messages-container">
        {messages.length === 0 ? (
          <div className="welcome-message">
            <div className="welcome-icon">🌟</div>
            <h3>欢迎来到智能心理咨询</h3>
            <p className="opening-statement">{openingStatement}</p>
            {suggestedQuestions.length > 0 && (
              <div className="suggestions">
                <p>你可以尝试询问：</p>
                <ul>
                  {suggestedQuestions.map((q, i) => (
                    <li key={i}>
                      <button
                        type="button"
                        className="suggestion-item"
                        onClick={() => setInputValue(q)}
                      >
                        {q}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ) : (
          messages.map((msg) => (
            <div key={msg.id} className={`message ${msg.role}`}>
              <div className="message-avatar">
                {msg.role === "user" ? "👤" : "🤖"}
              </div>
              <div className="message-content-wrapper">
                <div className="message-bubble">{msg.content || "..."}</div>

                {msg.role === "assistant" && msg.message_id && (
                  <div className="message-actions">
                    {textToSpeechEnabled && (
                      <button
                        type="button"
                        className={`action-btn ${playingAudioId === msg.message_id ? `active` : ``}`}
                        onClick={() => playTTS(msg.message_id!, msg.content)}
                        title="播放语音"
                      >
                        <Volume2 size={16} />
                      </button>
                    )}
                    <button
                      type="button"
                      className={`action-btn ${msg.feedback === `like` ? `active like` : ``}`}
                      onClick={() => handleFeedback(msg.message_id!, "like")}
                      title="有帮助"
                    >
                      <ThumbsUp size={16} />
                    </button>
                    <button
                      type="button"
                      className={`action-btn ${msg.feedback === `dislike` ? `active dislike` : ``}`}
                      onClick={() => handleFeedback(msg.message_id!, "dislike")}
                      title="没帮助"
                    >
                      <ThumbsDown size={16} />
                    </button>
                  </div>
                )}

                {msg.retriever_resources &&
                  msg.retriever_resources.length > 0 && (
                    <div className="citations">
                      <button
                        type="button"
                        className="citations-toggle"
                        onClick={() => toggleCitation(msg.message_id!)}
                      >
                        <span>
                          📚 引用 {msg.retriever_resources.length} 个来源
                        </span>
                        {expandedCitations.has(msg.message_id!) ? (
                          <ChevronUp size={16} />
                        ) : (
                          <ChevronDown size={16} />
                        )}
                      </button>
                      {expandedCitations.has(msg.message_id!) && (
                        <div className="citations-list">
                          {msg.retriever_resources.map((resource, index) => (
                            <div key={index} className="citation-item">
                              <div className="citation-header">
                                <span className="citation-title">
                                  {resource.document_name}
                                </span>
                                <span className="citation-score">
                                  相关度: {(resource.score * 100).toFixed(1)}%
                                </span>
                              </div>
                              <p className="citation-content">
                                {resource.content}
                              </p>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  )}

                {msg.role === "assistant" &&
                  msg.suggested_questions &&
                  msg.suggested_questions.length > 0 && (
                    <div className="suggested-questions">
                      <p>你可能想问：</p>
                      <div className="suggested-list">
                        {msg.suggested_questions.map((q, i) => (
                          <button
                            key={i}
                            type="button"
                            className="suggested-btn"
                            onClick={() => setInputValue(q)}
                          >
                            {q}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
              </div>
            </div>
          ))
        )}
        {isLoading && (
          <div className="message assistant">
            <div className="message-avatar">🤖</div>
            <div className="message-content-wrapper">
              <div className="message-bubble loading">
                <span className="dot" />
                <span className="dot" />
                <span className="dot" />
              </div>
            </div>
          </div>
        )}
        <div ref={messagesEndRef} />
      </div>

      <div className="chat-input-container">
        <textarea
          ref={inputRef}
          value={inputValue}
          onChange={(e) => setInputValue(e.target.value)}
          onKeyDown={handleKeyDown}
          placeholder="输入你的问题..."
          rows={1}
          className="chat-input"
          disabled={isLoading}
        />

        {speechToTextEnabled && (
          <button
            type="button"
            className={`voice-btn ${isRecording ? `recording` : ``}`}
            onClick={isRecording ? stopRecording : startRecording}
            disabled={isLoading}
            title="麦克风录音"
          >
            <div className="voice-btn-content">
              <Mic size={20} />
              {isRecording && (
                <div className="sound-wave">
                  <span />
                  <span />
                  <span />
                </div>
              )}
            </div>
          </button>
        )}

        <button
          type="button"
          onClick={handleSend}
          disabled={!inputValue.trim() || isLoading}
          className="send-button"
        >
          发送
        </button>
      </div>
      {transcribeStatus !== "idle" && (
        <div className={`transcribe-status ${transcribeStatus}`}>
          {transcribeStatus === "listening" && (
            <>
              <div className="status-icon listening">
                <span />
                <span />
                <span />
              </div>
              <span>聆听中...</span>
            </>
          )}
          {transcribeStatus === "transcribing" && (
            <>
              <div className="status-icon transcribing">
                <span />
                <span />
                <span />
              </div>
              <span>正在输入中...</span>
            </>
          )}
          {transcribeStatus === "done" && (
            <>
              <span className="done-icon">✓</span>
              <span>输入完成</span>
            </>
          )}
        </div>
      )}

      <style>{`
