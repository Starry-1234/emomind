          padding: 20px;
          height: calc(100vh - 120px);
          display: flex;
          flex-direction: column;
          box-sizing: border-box;
        }
        .counselor-chat-header {
          margin-bottom: 20px;
          padding-bottom: 15px;
          border-bottom: 2px solid #f0f0f0;
        }
        .counselor-chat-header h2 { margin: 0 0 8px 0; color: #2c3e50; }
        .counselor-chat-header p { margin: 0; color: #7f8c8d; }
        .new-chat-btn {
          padding: 8px 16px;
          background-color: #f5f5f5;
          border: 1px solid #ddd;
          border-radius: 8px;
          cursor: pointer;
          font-size: 14px;
          transition: all 0.2s;
        }
        .new-chat-btn:hover { background-color: #e8e8e8; }
        .header-actions { display: flex; gap: 12px; align-items: center; }
        .auto-play-btn {
          display: flex;
          align-items: center;
          gap: 6px;
          padding: 8px 12px;
          background-color: #f5f5f5;
          border: 1px solid #ddd;
          border-radius: 8px;
          cursor: pointer;
          font-size: 13px;
          color: #666;
          transition: all 0.2s;
        }
        .auto-play-btn:hover { background-color: #e8e8e8; }
        .auto-play-btn.active {
          background-color: #e8f5e9;
          border-color: #4caf50;
          color: #4caf50;
        }
        .chat-messages-container {
          flex: 1;
          overflow-y: auto;
          padding: 20px;
          background-color: #f8f9fa;
          border-radius: 16px;
          margin-bottom: 20px;
        }
        .welcome-message {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          height: 100%;
          text-align: center;
          color: #666;
        }
        .welcome-icon { font-size: 48px; margin-bottom: 20px; }
        .welcome-message h3 { margin: 0 0 10px 0; color: #333; }
        .welcome-message p { margin: 0 0 20px 0; }
        .opening-statement { color: #555; font-size: 16px; max-width: 600px; }
