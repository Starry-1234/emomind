import { createFileRoute, useNavigate } from "@tanstack/react-router"
import {
  Download,
  Mic,
  MicOff,
  Pause,
  Play,
  RotateCcw,
  Upload,
} from "lucide-react"
import { useEffect, useRef, useState } from "react"

export const Route = createFileRoute("/_layout/audio-recording")({
  component: AudioRecording,
  head: () => ({
    meta: [{ title: "在线音频录制 - 心芯智联" }],
  }),
})

export default function AudioRecording() {
  const navigate = useNavigate()
  const [isRecording, setIsRecording] = useState(false)
  const [recordedBlob, setRecordedBlob] = useState<Blob | null>(null)
  const [audioUrl, setAudioUrl] = useState<string | null>(null)
  const [recordingTime, setRecordingTime] = useState(0)
  const [totalTime, setTotalTime] = useState(0)
  const [isPlaying, setIsPlaying] = useState(false)
  const [permissionDenied, setPermissionDenied] = useState(false)
  const [isUploading, setIsUploading] = useState(false)

  const mediaRecorderRef = useRef<MediaRecorder | null>(null)
  const timerRef = useRef<number | null>(null)
  const audioRef = useRef<HTMLAudioElement | null>(null)
  const streamRef = useRef<MediaStream | null>(null)
  const audioChunksRef = useRef<Blob[]>([])

  useEffect(() => {
    return () => {
      if (timerRef.current) clearInterval(timerRef.current)
      if (audioUrl) URL.revokeObjectURL(audioUrl)
      if (streamRef.current)
        streamRef.current.getTracks().forEach((track) => {
          track.stop()
        })
    }
  }, [audioUrl])

  const startRecording = async () => {
    try {
      setPermissionDenied(false)
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
      streamRef.current = stream
      const mediaRecorder = new MediaRecorder(stream)
      mediaRecorderRef.current = mediaRecorder
      audioChunksRef.current = []

      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) audioChunksRef.current.push(event.data)
      }

      mediaRecorder.onstop = () => {
        const blob = new Blob(audioChunksRef.current, { type: "audio/webm" })
        setRecordedBlob(blob)
        setAudioUrl(URL.createObjectURL(blob))
        stream.getTracks().forEach((track) => {
          track.stop()
        })
      }

      mediaRecorder.start()
      setIsRecording(true)
      setRecordingTime(0)
      timerRef.current = window.setInterval(() => {
        setRecordingTime((prev) => prev + 1)
        setTotalTime((prev) => prev + 1)
      }, 1000)
    } catch (error) {
      console.error("无法访问麦克风:", error)
      setPermissionDenied(true)
    }
  }

  const stopRecording = () => {
    if (mediaRecorderRef.current && isRecording) {
      mediaRecorderRef.current.stop()
      setIsRecording(false)
      if (timerRef.current) {
        clearInterval(timerRef.current)
        timerRef.current = null
      }
    }
  }

  const downloadRecording = () => {
    if (!recordedBlob) return
    const timestamp = new Date().toISOString().slice(0, 19).replace(/[:-]/g, "")
    const a = document.createElement("a")
    a.href = URL.createObjectURL(recordedBlob)
    a.download = `录音_${timestamp}.webm`
    a.click()
  }

  const uploadToAnalysis = async () => {
    if (!recordedBlob) return
    setIsUploading(true)
    try {
      const timestamp = new Date()
        .toISOString()
        .slice(0, 19)
        .replace(/[:-]/g, "")
      const filename = `录音_${timestamp}.webm`
      const file = new File([recordedBlob], filename, { type: "audio/webm" })

      const pendingFiles = JSON.parse(
        sessionStorage.getItem("pendingAudioFiles") || "[]",
      )
      pendingFiles.push({
        name: filename,
        type: "audio",
        timestamp: Date.now(),
      })
      sessionStorage.setItem("pendingAudioFiles", JSON.stringify(pendingFiles))

      const reader = new FileReader()
      reader.onload = () => {
        const filesData = JSON.parse(
          sessionStorage.getItem("pendingFilesData") || "{}",
        )
        filesData[filename] = reader.result
        sessionStorage.setItem("pendingFilesData", JSON.stringify(filesData))
        setIsUploading(false)
        navigate({ to: "/file-upload" })
      }
      reader.readAsDataURL(file)
    } catch {
      console.error("上传失败:")
      setIsUploading(false)
      alert("上传失败，请重试")
    }
  }

  const playRecording = () => {
    if (!audioUrl || !audioRef.current) return
    if (isPlaying) {
      audioRef.current.pause()
      setIsPlaying(false)
    } else {
      audioRef.current.play()
      setIsPlaying(true)
    }
  }

  const resetRecording = () => {
    if (audioUrl) URL.revokeObjectURL(audioUrl)
    setRecordedBlob(null)
    setAudioUrl(null)
    setRecordingTime(0)
    setTotalTime(0)
    setIsPlaying(false)
    audioChunksRef.current = []
  }

  const formatTime = (seconds: number) =>
    `${Math.floor(seconds / 60)
      .toString()
      .padStart(2, "0")}:${(seconds % 60).toString().padStart(2, "0")}`

  return (
    <div className="container mx-auto p-6 max-w-2xl">
      <h1 className="text-3xl font-bold mb-8 text-center">在线音频录制</h1>

      <div className="bg-white rounded-xl shadow-sm p-8 border">
        <div className="flex flex-col items-center gap-8">
          <div
            className={`w-32 h-32 rounded-full flex items-center justify-center transition-all ${isRecording ? `bg-red-100 animate-pulse shadow-lg shadow-red-200` : recordedBlob ? `bg-green-100` : `bg-gray-100`}`}
          >
            {isRecording ? (
              <MicOff className="w-16 h-16 text-red-500" />
            ) : (
              <Mic
                className={`w-16 h-16 ${recordedBlob ? `text-green-500` : `text-gray-400`}`}
              />
            )}
          </div>

          <div className="text-center">
            {isRecording ? (
              <>
                <p className="text-4xl font-mono text-red-500 mb-2">
                  {formatTime(recordingTime)}
                </p>
                <p className="text-gray-500">录制中...</p>
                {totalTime > 0 && (
                  <p className="text-sm text-gray-400">
                    总时长: {formatTime(totalTime)}
                  </p>
                )}
              </>
            ) : recordedBlob ? (
              <>
                <p className="text-4xl font-mono text-gray-700 mb-2">
                  {formatTime(totalTime)}
                </p>
                <p className="text-green-500">录制完成</p>
              </>
            ) : (
              <>
                <p className="text-4xl font-mono text-gray-400 mb-2">00:00</p>
                <p className="text-gray-500">准备就绪</p>
              </>
            )}
          </div>

          {permissionDenied && (
            <div className="w-full p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 text-center">
              麦克风权限被拒绝，请允许浏览器访问麦克风后重试。
            </div>
          )}

          <div className="flex gap-4 flex-wrap justify-center">
            {!recordedBlob ? (
              <button
                type="button"
                onClick={isRecording ? stopRecording : startRecording}
                className={`px-8 py-3 rounded-xl font-semibold text-white transition-all ${isRecording ? `bg-red-500 hover:bg-red-600` : `bg-blue-500 hover:bg-blue-600`}`}
              >
                {isRecording ? (
                  <>
                    <MicOff size={20} className="inline mr-2" />
                    停止录制
                  </>
                ) : (
                  <>
                    <Mic size={20} className="inline mr-2" />
                    开始录制
                  </>
                )}
              </button>
            ) : (
              <>
                <button
                  type="button"
                  onClick={playRecording}
                  className="px-6 py-3 bg-blue-500 text-white rounded-xl font-semibold hover:bg-blue-600 transition-all flex items-center gap-2"
                >
                  {isPlaying ? (
                    <>
                      <Pause size={20} />
                      暂停
                    </>
                  ) : (
                    <>
                      <Play size={20} />
                      播放
                    </>
                  )}
                </button>
                <button
                  type="button"
                  onClick={uploadToAnalysis}
                  disabled={isUploading}
                  className="px-6 py-3 bg-green-500 text-white rounded-xl font-semibold hover:bg-green-600 transition-all flex items-center gap-2 disabled:opacity-50"
                >
                  <Upload size={20} />
                  {isUploading ? "上传中..." : "直接上传"}
                </button>
                <button
                  type="button"
                  onClick={downloadRecording}
                  className="px-6 py-3 bg-green-500 text-white rounded-xl font-semibold hover:bg-green-600 transition-all flex items-center gap-2"
                >
                  <Download size={20} />
                  下载
                </button>
                <button
                  type="button"
                  onClick={resetRecording}
                  className="px-6 py-3 bg-gray-200 text-gray-700 rounded-xl font-semibold hover:bg-gray-300 transition-all flex items-center gap-2"
                >
                  <RotateCcw size={20} />
                  重新录制
                </button>
              </>
            )}
          </div>

          {audioUrl && (
            <audio
              ref={audioRef}
              src={audioUrl}
              onEnded={() => setIsPlaying(false)}
              className="hidden"
            >
              <track kind="captions" />
            </audio>
          )}
        </div>
      </div>

      <div className="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-200">
        <h3 className="font-semibold text-blue-800 mb-2">使用说明</h3>
        <ul className="text-sm text-blue-700 space-y-1">
          <li>1. 点击「开始录制」按钮，允许浏览器访问麦克风</li>
          <li>2. 开始说话或录制您需要的内容</li>
          <li>3. 录制完成后点击「停止录制」</li>
          <li>4. 点击「直接上传」可跳转至分析页面继续</li>
          <li>5. 音频格式为 WebM，兼容大多数浏览器</li>
        </ul>
      </div>
    </div>
  )
}
