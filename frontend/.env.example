# DEPRECATED: Frontend environment variables are now managed in the root .env file
#
# The frontend reads VITE_* prefixed variables from the root .env file
# via vite.config.ts envDir: "../" configuration.
#
# Please configure all environment variables in: ../.env
#
# Required variables for the frontend:
# - VITE_API_URL=http://localhost:8080
#
# See ../.env.example for the full template.
